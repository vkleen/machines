neodymium       IN TXT "v=spf1 redirect=kleen.org"

remarkable      IN A    188.68.45.180
remarkable      IN AAAA 2a03:4000:54:9b1::1

riot            IN A    188.68.45.180
riot            IN AAAA 2a03:4000:54:9b1::1

turn            IN A    188.68.45.180
turn            IN AAAA 2a03:4000:54:9b1::1

europium        IN A    172.104.139.29
europium        IN AAAA 2a01:7e01::f03c:92ff:fe12:a0f4

matrix          IN A    188.68.45.180
matrix          IN AAAA 2a03:4000:54:9b1::1

_matrix._tcp    IN SRV 10 0 443 neodymium.kleen.org.

ejabberd        CNAME neodymium.kleen.org.

grafana         CNAME europium.kleen.org.

muc.xmpp        CNAME neodymium.kleen.org.
proxy.xmpp      CNAME neodymium.kleen.org.
pubsub.xmpp     CNAME neodymium.kleen.org.
xmpp            CNAME neodymium.kleen.org.

_acme-challenge           IN NS ns.kleen.org.
_acme-challenge.paperless IN NS ns.kleen.org.
_acme-challenge.neodymium IN NS ns.kleen.org.
_acme-challenge.matrix IN NS ns.kleen.org.
_acme-challenge.riot IN NS ns.kleen.org.
_acme-challenge.turn IN NS ns.kleen.org.

_acme-challenge.ejabberd IN NS ns.kleen.org.

_acme-challenge.xmpp IN NS ns.kleen.org.
